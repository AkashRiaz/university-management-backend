model InvoiceItem {
  id String @id @default(uuid())

  invoiceId String

  name String

  description String?

  quantity Int @default(1)

  unitPrice Decimal @db.Decimal(12, 2)

  totalPrice Decimal @db.Decimal(12, 2)

  invoice Invoice @relation( fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}
