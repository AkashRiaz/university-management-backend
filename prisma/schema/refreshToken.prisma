model RefreshToken {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())


  user User @relation(fields: [userId], references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
