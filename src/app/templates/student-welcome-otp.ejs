<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Account Created</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f3f4f6;
  font-family: Arial, Helvetica, sans-serif;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="background-color: #f3f4f6; padding: 40px 15px;"
  >
    <tr>
      <td align="center">

```
    <table
      width="600"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="
        width: 100%;
        max-width: 600px;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
      "
    >

      <!-- Header -->
      <tr>
        <td
          align="center"
          style="
            background-color: #2563eb;
            padding: 30px 20px;
          "
        >
          <h1 style="
            margin: 0;
            color: #ffffff;
            font-size: 26px;
          ">
            Welcome to Our Institution
          </h1>

          <p style="
            margin: 10px 0 0;
            color: #dbeafe;
            font-size: 14px;
          ">
            Your student account has been created successfully
          </p>
        </td>
      </tr>

      <!-- Content -->
      <tr>
        <td style="padding: 35px 30px;">

          <p style="
            margin: 0 0 15px;
            color: #111827;
            font-size: 17px;
          ">
            Hello <strong><%= name %></strong>,
          </p>

          <p style="
            margin: 0 0 20px;
            color: #4b5563;
            font-size: 15px;
            line-height: 1.7;
          ">
            Your student account has been created successfully.
            Please verify your email address using the OTP below.
          </p>

          <!-- Student Information -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              background-color: #f9fafb;
              border-radius: 8px;
              margin-bottom: 25px;
            "
          >
            <tr>
              <td style="
                padding: 12px 15px;
                color: #6b7280;
                font-size: 14px;
              ">
                Student ID
              </td>

              <td
                align="right"
                style="
                  padding: 12px 15px;
                  color: #111827;
                  font-size: 14px;
                  font-weight: bold;
                "
              >
                <%= studentId %>
              </td>
            </tr>
          </table>

          <!-- OTP Section -->
          <div style="text-align: center;">

            <p style="
              margin: 0 0 10px;
              color: #374151;
              font-size: 14px;
            ">
              Your verification OTP is:
            </p>

            <div style="
              display: inline-block;
              padding: 15px 30px;
              background-color: #eff6ff;
              border: 1px solid #bfdbfe;
              border-radius: 8px;
            ">
              <span style="
                color: #2563eb;
                font-size: 32px;
                font-weight: bold;
                letter-spacing: 8px;
              ">
                <%= otp %>
              </span>
            </div>

            <p style="
              margin: 15px 0 0;
              color: #6b7280;
              font-size: 13px;
            ">
              This OTP will expire in
              <strong><%= expirationMinutes %> minutes</strong>.
            </p>

          </div>

          <!-- Temporary Password -->
          <div style="
            margin-top: 30px;
            padding: 20px;
            background-color: #fff7ed;
            border: 1px solid #fed7aa;
            border-radius: 8px;
          ">

            <p style="
              margin: 0 0 10px;
              color: #9a3412;
              font-size: 14px;
              font-weight: bold;
            ">
              Temporary Password
            </p>

            <p style="
              margin: 0;
              color: #7c2d12;
              font-size: 20px;
              font-weight: bold;
              word-break: break-all;
            ">
              <%= tempPassword %>
            </p>

            <p style="
              margin: 10px 0 0;
              color: #9a3412;
              font-size: 12px;
              line-height: 1.5;
            ">
              Please change this temporary password after your first login.
            </p>

          </div>

          <!-- Security Notice -->
          <p style="
            margin: 25px 0 0;
            color: #6b7280;
            font-size: 13px;
            line-height: 1.6;
          ">
            <strong>Security notice:</strong>
            Never share your OTP or password with anyone.
            If you did not request this account, please contact your
            institution administrator.
          </p>

        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td
          align="center"
          style="
            background-color: #f9fafb;
            padding: 20px 30px;
            border-top: 1px solid #e5e7eb;
          "
        >

          <p style="
            margin: 0;
            color: #9ca3af;
            font-size: 12px;
          ">
            This is an automated email. Please do not reply.
          </p>

          <p style="
            margin: 8px 0 0;
            color: #9ca3af;
            font-size: 12px;
          ">
            © <%= new Date().getFullYear() %> Your Institution
          </p>

        </td>
      </tr>

    </table>

  </td>
</tr>
```

  </table>

</body>
</html>
